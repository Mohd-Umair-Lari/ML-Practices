# Example snippet for visualization (conceptual)
import matplotlib.pyplot as plt
from PIL import Image
import numpy as np

# Load and convert image to 64x64 grayscale
img = Image.open('path_to_your_image.jpg').convert('L')
img_resized = img.resize((64, 64))

# Display
plt.imshow(np.array(img_resized), cmap='gray')
plt.show()