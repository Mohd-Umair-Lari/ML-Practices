    "import numpy as np\n",
    "import math\n",
    "points = np.array([(1,1), (2,1), (3,4), (5,7), (3,3)])\n",
    "def euclidean(p1, p2):\n",
    "    return math.sqrt(np.sum((p1 - p2) ** 2))\n",
    "print (euclidean)"
